# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/karapardaz?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/karapardaz

# Authentication Secret (Used by jose HS256, minimum 32 chars recommended)
JWT_SECRET=kara_pardaz_super_secret_jwt_key_at_least_32_characters_long_2026

# Token expiration (e.g. 7d, 24h, 12h)
JWT_EXPIRES_IN=7d

# Initial Admin User (used by npm run seed:admin)
INITIAL_ADMIN_EMAIL=admin@karapardaz.com
INITIAL_ADMIN_PASSWORD=AdminSecurePassword2026!
INITIAL_ADMIN_NAME=مدیر ارشد کارا پرداز
