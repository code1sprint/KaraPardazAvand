# ==============================================================================
# KaraPardaz Production Environment
# ==============================================================================

# Public site URL (used in canonical links, sitemaps, open-graph)
NEXT_PUBLIC_SITE_URL=https://karapardazavand.ir

# Connect to shared MongoDB inside amlak_amlak-net network:
# Format: mongodb://<user>:<password>@amlak-mongo:27017/karapardaz?authSource=admin
MONGODB_URI=mongodb://karapardaz:YOUR_SECURE_PASSWORD@amlak-mongo:27017/karapardaz?authSource=admin

# JWT Authentication Secret (generate with: openssl rand -base64 32)
JWT_SECRET=replace_with_a_super_secret_key_at_least_32_chars_long

# JWT Expiration
JWT_EXPIRES_IN=7d

# Initial Admin User for scripts/seed-admin.ts
INITIAL_ADMIN_EMAIL=admin@karapardaz.com
INITIAL_ADMIN_PASSWORD=SetAStrongPassword2026!
INITIAL_ADMIN_NAME=مدیر ارشد کارا پرداز

# Docker network name of AMLAK stack (check with: docker network ls | grep amlak)
AMLAK_NETWORK=amlak_amlak-net

